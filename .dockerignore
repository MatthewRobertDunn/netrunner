# Keep the build context minimal: only src, data inputs, SVG assets, the
# checked-in public shell (index.html, css, serve.ts) and build scripts.
# Everything under public/{dist,images,assets} is regenerated in-image.

.git
.gitignore
.playwright-mcp
opencode.json
README.md
docs
tests

# Engine data not needed by the web build
data/raw

# Web build outputs (regenerated inside the image)
public/dist
public/images
public/assets

# Docker files themselves
Dockerfile
.dockerignore
