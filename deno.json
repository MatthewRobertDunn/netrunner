{
  "nodeModulesDir": "none",
  "imports": {
    "vue": "npm:vue@3.5.13/dist/vue.esm-bundler.js",
    "@vue/test-utils": "npm:@vue/test-utils@2.4.6",
    "happy-dom": "npm:happy-dom@15.7.4"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false,
    "indentWidth": 2,
    "exclude": ["public/dist", "worktrees"]
  },
  "lint": {
    "exclude": ["public/dist", "worktrees"]
  },
  "tasks": {
    "import-decks": "deno run --allow-net --allow-read --allow-write scripts/import-starter-decks.ts",
    "fetch-images": "deno run --allow-net --allow-read --allow-write scripts/fetch-card-images.ts",
    "test": "deno test --allow-read --allow-env",
    "check-ai": "deno run --allow-read scripts/check-ai.ts",
    "publish": "deno run --allow-read --allow-write --allow-run --allow-net scripts/publish.ts",
    "check": "deno check src/mod.ts src/web/entry.ts",
    "lint": "deno lint src tests scripts",
    "fmt": "deno fmt src tests scripts",
    "fmt:check": "deno fmt --check src tests scripts",
    "verify": "deno fmt --check src tests scripts && deno task lint && deno task check && deno task test",
    "build-web": "deno run --allow-read --allow-write --allow-net --allow-run scripts/build-web.ts",
    "serve-web": "deno run -A public/serve.ts"
  },
  "test": {
    "include": ["tests/"]
  }
}
