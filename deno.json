{
  "nodeModulesDir": "none",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false,
    "indentWidth": 2
  },
  "tasks": {
    "import-decks": "deno run --allow-net --allow-read --allow-write scripts/import-starter-decks.ts",
    "test": "deno test --allow-read",
    "check": "deno check src/mod.ts scripts/import-starter-decks.ts",
    "lint": "deno lint src tests scripts",
    "fmt": "deno fmt src tests scripts",
    "fmt:check": "deno fmt --check src tests scripts"
  },
  "test": {
    "include": ["tests/"]
  }
}
